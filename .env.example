# Copy to .env (next to docker-compose.yml) and fill in your keys.

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Cloudinary (media storage + CDN): https://console.cloudinary.com → "API Environment variable"
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Real e-mail delivery (optional). Empty = Mailpit catches all mails: http://localhost:8025
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it below (not your normal password).
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
